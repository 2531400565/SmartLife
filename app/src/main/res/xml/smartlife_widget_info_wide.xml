<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件配置 · 4×2（v2.0 P2 新增）。
  - minWidth/minHeight：兼容旧版启动器（4×2 网格）；
  - targetCellWidth/Height：Android 12+ 的网格尺寸建议；
  - updatePeriodMillis：系统最小刷新间隔为 30 分钟（1800000），
    另外应用在前台时也会主动刷新，保证数据尽量实时。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_smartlife_wide"
    android:previewLayout="@layout/widget_smartlife_wide"
    android:description="@string/widget_description_wide"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
